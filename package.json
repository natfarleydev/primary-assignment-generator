{
  "name": "primary-assignment-generator",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/core/*.test.js\"",
    "build": "node scripts/build.js",
    "check": "npm test && npm run test:integration",
    "screenshots": "npm run build && node scripts/screenshots.js",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:integration": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "^0.24.2"
  }
}
