    "check": "npm test && npm run test:e2e",
    "screenshots": "npm run build && node scripts/screenshots.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "playwright": "1.63.0"
  }
}
